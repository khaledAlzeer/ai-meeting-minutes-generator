# ---------------------------------------------------------------------------
# AI Meeting Minutes Generator — environment configuration
#
# Copy this file to `.env` and fill in the values you need.
# `.env` is git-ignored and should never be committed.
# ---------------------------------------------------------------------------

# REQUIRED: Hugging Face access token with access to gated models
# (Llama 3.2 requires you to request/accept access on the model page).
# Create a token at: https://huggingface.co/settings/tokens
# Request model access at: https://huggingface.co/meta-llama/Llama-3.2-3B-Instruct
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Model configuration (optional overrides)
# ---------------------------------------------------------------------------
WHISPER_MODEL_ID=openai/whisper-medium.en
LLM_MODEL_ID=meta-llama/Llama-3.2-3B-Instruct

LLM_MAX_NEW_TOKENS=2000
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_REPETITION_PENALTY=1.1

# Set to "false" to disable 4-bit quantization (requires more GPU memory).
# Automatically disabled on machines without a CUDA GPU.
USE_4BIT_QUANTIZATION=true

WHISPER_CHUNK_LENGTH_S=30

# ---------------------------------------------------------------------------
# Server / Gradio configuration
# ---------------------------------------------------------------------------
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
GRADIO_QUEUE_MAX_SIZE=20

# ---------------------------------------------------------------------------
# Limits & validation
# ---------------------------------------------------------------------------
MAX_AUDIO_SIZE_MB=200
MIN_TRANSCRIPT_CHARACTERS=10

# ---------------------------------------------------------------------------
# Miscellaneous
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# One of: auto, cuda, cpu
DEVICE_PREFERENCE=auto

APP_AUTHOR=Khaled Alzeer
APP_REPOSITORY_URL=https://github.com/khaledAlzeer/ai-meeting-minutes-generator
